# ====================================================================
# LINGOCAT 🐾 - ENVIRONMENT VARIABLES TEMPLATE
# Copy file này thành .env.local và điền các thông số từ Supabase Dashboard:
# Project Settings -> API (Keys & URL)
# ====================================================================

# 1. Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Publishable / Anon Key (Dùng cho Client Browser & Frontend)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# 3. Supabase Service Role Key (Chỉ dùng cho script nạp dữ liệu cào / backend admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
